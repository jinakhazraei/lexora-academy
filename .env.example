# Resend (https://resend.com) — used by /api/contact to email form submissions,
# and to notify teachers about review requests and students about finished reviews.
RESEND_API_KEY=

# Where consultation requests (and review requests for students without an assigned teacher) are sent.
CONTACT_TO_EMAIL=mahtablexora@gmail.com

# Must be a verified sender on your Resend account/domain.
# The default below only works in Resend's sandbox mode (delivers to your own account email).
CONTACT_FROM_EMAIL="Lexora Academy <onboarding@resend.dev>"

# The live site address, used in email links and auth redirects.
NEXT_PUBLIC_SITE_URL=https://www.lexora-academy-institute.online

# ── Student accounts (Supabase) ── see docs/SETUP.md
# Supabase dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never expose this to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SECRET_KEY=
# Show "Continue with Google" once the Google provider is set up in Supabase.
NEXT_PUBLIC_ENABLE_GOOGLE_LOGIN=false

# ── Writing Feedback scorer ── see docs/WRITING_SCORER.md
# "claude" (default) uses the Anthropic API; "http" calls your own model at ESSAY_SCORER_URL.
ESSAY_SCORER=claude
ANTHROPIC_API_KEY=
# Optional — defaults to claude-sonnet-5-5.
ANTHROPIC_MODEL=
# Only for ESSAY_SCORER=http:
ESSAY_SCORER_URL=
ESSAY_SCORER_TOKEN=

# Essays per student per 24 hours (keeps API costs predictable). 0 = no limit. Teachers aren't limited.
WRITING_DAILY_LIMIT=10
